# Copy to the ignored services/appointment-service/.env for local development.
# For Compose, use the root .env and the service-specific names documented there.
NODE_ENV=development
APPOINTMENT_SERVICE_PORT=3003

# Appointment Service's own PostgreSQL database (never use another service's DB).
# Use a URL-encoded password. DATABASE_SSL=false is for local PostgreSQL only.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_APPOINTMENT_DB_HOST:5432/postgres
DATABASE_SSL=true
# Keep true when the database CA is trusted. Set false only for providers/poolers
# whose CA is not installed in the runtime; this disables certificate verification.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Internal backend URLs; local defaults shown. Do not expose these to either frontend.
DOCTOR_SERVICE_URL=http://localhost:3002
USER_SERVICE_URL=http://localhost:3001
MEDICAL_RECORD_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005

# Caller credentials: each secret must be independently random, at least 32 bytes,
# and private. Generate independent values with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Appointment -> User patient lookup/outbox completion. Must match User Service's
# USER_APPOINTMENT_INTERNAL_API_TOKEN. Do not reuse any other internal token.
USER_APPOINTMENT_INTERNAL_API_TOKEN=replace-with-independent-64-hex-character-secret
# User -> Appointment GET /internal/v1/appointments/{id}/patient-scope only.
# Must differ from APPOINTMENT_RECORD_INTERNAL_API_TOKEN and every other token.
APPOINTMENT_USER_INTERNAL_API_TOKEN=replace-with-another-independent-64-hex-character-secret
# Shared Doctor <-> Appointment credential (occupancy and doctor lookup). Must
# exactly match Doctor Service's DOCTOR_INTERNAL_API_TOKEN.
DOCTOR_INTERNAL_API_TOKEN=replace-with-a-third-independent-64-hex-character-secret
# Medical Record -> Appointment verification/completion callbacks only.
APPOINTMENT_RECORD_INTERNAL_API_TOKEN=replace-with-a-fourth-independent-64-hex-character-secret
# Notification -> Appointment reminder-context reads only.
APPOINTMENT_NOTIFICATION_INTERNAL_API_TOKEN=replace-with-a-fifth-independent-64-hex-character-secret
# Appointment -> Notification event ingestion. Must match Notification Service's
# NOTIFICATION_INTERNAL_API_TOKEN and remain distinct from all other credentials.
NOTIFICATION_INTERNAL_API_TOKEN=replace-with-a-sixth-independent-64-hex-character-secret

# Outbox delivery polling interval in milliseconds; defaults to 5000 (5 seconds).
APPOINTMENT_OUTBOX_POLL_MS=5000
# Optional application logging verbosity, e.g. debug, info, warn, error.
LOG_LEVEL=info
