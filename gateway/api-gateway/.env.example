GATEWAY_PORT=8080
NODE_ENV=development
AUTH_DEV_MODE=false
# This must exactly match User Service's USER_GATEWAY_INTERNAL_API_TOKEN.
# Generate 32 random bytes with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Put that same generated value in both private backend .env files; never expose it
# in a frontend or commit either populated .env file.
# USER_GATEWAY_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_GATEWAY_TO_USER_TOKEN

CLINIC_MANAGEMENT_WEB_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5174
USER_SERVICE_URL=http://localhost:3001
DOCTOR_SERVICE_URL=http://localhost:3002
APPOINTMENT_SERVICE_URL=http://localhost:3003
MEDICAL_RECORD_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_TIMEOUT_MS=3000
HEALTH_CHECK_TIMEOUT_MS=1500
PROXY_TIMEOUT_MS=20000
