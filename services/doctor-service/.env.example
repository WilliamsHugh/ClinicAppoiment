# Copy to the ignored services/doctor-service/.env for local development.
# For Compose, use the root .env and the service-specific names documented there.
DOCTOR_SERVICE_PORT=3002

# Doctor Service's own PostgreSQL database (never use another service's database).
# Use a URL-encoded password. DATABASE_SSL=false is for local PostgreSQL only.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_DOCTOR_DB_HOST:5432/postgres
DATABASE_SSL=true
# Keep true when the database CA is trusted. Set false only for providers/poolers
# whose CA is not installed in the runtime; this disables certificate verification.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Internal backend URLs; local defaults shown. Do not expose these to either frontend.
USER_SERVICE_URL=http://localhost:3001
APPOINTMENT_SERVICE_URL=http://localhost:3003

# Caller credentials: each secret must be random, at least 32 bytes, and kept private.
# Generate independent values with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Doctor -> User account eligibility. Must exactly match User Service's
# USER_DOCTOR_INTERNAL_API_TOKEN. Do not reuse any other internal token.
USER_DOCTOR_INTERNAL_API_TOKEN=replace-with-independent-64-hex-character-secret
# Additional User -> Doctor credential for GET /internal/v1/doctors/by-user/{userId}.
# Set the same value on User Service as DOCTOR_USER_INTERNAL_API_TOKEN. The route
# also retains the existing DOCTOR_INTERNAL_API_TOKEN caller for compatibility.
# This additional credential must be distinct from all others.
DOCTOR_USER_INTERNAL_API_TOKEN=replace-with-another-independent-64-hex-character-secret
# Shared Appointment/Medical Record -> Doctor internal credential and Doctor ->
# Appointment occupancy credential. Set this exact value on Appointment Service
# as DOCTOR_INTERNAL_API_TOKEN. Distinct from the two User-related credentials.
DOCTOR_INTERNAL_API_TOKEN=replace-with-a-third-independent-64-hex-character-secret

# Optional application logging verbosity, e.g. debug, info, warn, error.
LOG_LEVEL=info
