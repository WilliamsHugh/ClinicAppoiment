# Local development defaults. Do not commit a populated .env file.
NODE_ENV=development

# Gateway authentication policy. Keep AUTH_DEV_MODE=false outside local fixture testing.
AUTH_DEV_MODE=false
# Same backend-only secret for Gateway -> User token verification (32+ bytes).
# Set a unique random value in local .env; never expose it to either frontend.
# USER_GATEWAY_INTERNAL_API_TOKEN=replace-with-a-unique-random-secret-at-least-32-bytes
# Internal service credentials. Generate a different random value for every variable;
# Compose supplies the same variable to each caller/provider that shares that credential.
# USER_DOCTOR_INTERNAL_API_TOKEN=replace-with-unique-secret-32-bytes-minimum
# USER_APPOINTMENT_INTERNAL_API_TOKEN=replace-with-unique-secret-32-bytes-minimum
# USER_RECORD_INTERNAL_API_TOKEN=replace-with-unique-secret-32-bytes-minimum
# DOCTOR_USER_INTERNAL_API_TOKEN=replace-with-unique-secret-32-bytes-minimum
# APPOINTMENT_USER_INTERNAL_API_TOKEN=replace-with-unique-secret-32-bytes-minimum
# DOCTOR_INTERNAL_API_TOKEN=replace-with-unique-secret-32-bytes-minimum
# APPOINTMENT_RECORD_INTERNAL_API_TOKEN=replace-with-unique-secret-32-bytes-minimum
# APPOINTMENT_NOTIFICATION_INTERNAL_API_TOKEN=replace-with-unique-secret-32-bytes-minimum
# NOTIFICATION_INTERNAL_API_TOKEN=replace-with-unique-secret-32-bytes-minimum
# Supabase Auth project used only by User Service (Dashboard -> Connect / API Keys).
# SUPABASE_URL=https://<auth-project-ref>.supabase.co
# SUPABASE_ANON_KEY=<publishable-key-or-legacy-anon-key>
# Keep the publishable/anon key on the backend here; never copy a secret/service_role key
# into this variable, either frontend, or a committed .env file.
AUTH_PROVIDER_TIMEOUT_MS=15000

# Public host ports and browser-facing URLs.
GATEWAY_PORT=8080
CLINIC_MANAGEMENT_WEB_PORT=5174
CLINIC_MANAGEMENT_WEB_URL=http://localhost:5174
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
PATIENT_APP_API_BASE_URL=http://10.0.2.2:8080
# Optional local toolchain overrides. Device IDs are listed by `flutter devices`.
# FLUTTER_DEVICE_ID=emulator-5554
# JAVA_HOME=/absolute/path/to/jdk-17

# Gateway limits and timeouts.
CORS_ORIGINS=http://localhost:5174
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_TIMEOUT_MS=3000
HEALTH_CHECK_TIMEOUT_MS=1500
PROXY_TIMEOUT_MS=20000

# Used when services run directly on the host. Compose overrides these with
# service DNS names and keeps the service ports private by default.
USER_SERVICE_URL=http://localhost:3001
DOCTOR_SERVICE_URL=http://localhost:3002
# Compose requires a random 32+ byte secret shared only by Doctor and Appointment services.
# DOCTOR_INTERNAL_API_TOKEN=
# Set three different random 32+ byte secrets shared with the named service.
# APPOINTMENT_RECORD_INTERNAL_API_TOKEN=
# APPOINTMENT_NOTIFICATION_INTERNAL_API_TOKEN=
# NOTIFICATION_INTERNAL_API_TOKEN=
APPOINTMENT_SERVICE_URL=http://localhost:3003
MEDICAL_RECORD_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005

# Host ports used only by infrastructure/compose/docker-compose.debug.yml.
USER_SERVICE_PORT=3001
DOCTOR_SERVICE_PORT=3002
APPOINTMENT_SERVICE_PORT=3003
MEDICAL_RECORD_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005

# Each service owns an independent Supabase project/database. Copy that project's
# connection string from Dashboard -> Connect -> Session pooler or Direct connection;
# URL-encode special characters in the database password. Direct connection format:
# postgresql://postgres:<URL_ENCODED_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres
# If your network is IPv4-only, use the Session pooler format shown by that project:
# postgresql://postgres.<project-ref>:<URL_ENCODED_PASSWORD>@<pooler-host>:5432/postgres
# Set each URL from its matching service project; do not reuse one project across services.
# USER_DATABASE_URL=postgresql://postgres:<URL_ENCODED_PASSWORD>@db.<user-project-ref>.supabase.co:5432/postgres
# DOCTOR_DATABASE_URL=postgresql://postgres:<URL_ENCODED_PASSWORD>@db.<doctor-project-ref>.supabase.co:5432/postgres
# APPOINTMENT_DATABASE_URL=postgresql://postgres:<URL_ENCODED_PASSWORD>@db.<appointment-project-ref>.supabase.co:5432/postgres
# MEDICAL_RECORD_DATABASE_URL=postgresql://postgres:<URL_ENCODED_PASSWORD>@db.<medical-record-project-ref>.supabase.co:5432/postgres
# NOTIFICATION_DATABASE_URL=postgresql://postgres:<URL_ENCODED_PASSWORD>@db.<notification-project-ref>.supabase.co:5432/postgres
# USER_DATABASE_SSL=true
# USER_DATABASE_SSL_REJECT_UNAUTHORIZED=false
# DOCTOR_DATABASE_SSL=true
# DOCTOR_DATABASE_SSL_REJECT_UNAUTHORIZED=false
# APPOINTMENT_DATABASE_SSL=true
# APPOINTMENT_DATABASE_SSL_REJECT_UNAUTHORIZED=false
# MEDICAL_RECORD_DATABASE_SSL=true
# MEDICAL_RECORD_DATABASE_SSL_REJECT_UNAUTHORIZED=false
# NOTIFICATION_DATABASE_SSL=true
# NOTIFICATION_DATABASE_SSL_REJECT_UNAUTHORIZED=false
LOG_LEVEL=info
