USER_SERVICE_PORT=3001
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_USER_DB_HOST:5432/postgres
DATABASE_SSL=true
# Supabase pooler may require false unless its CA certificate is installed locally.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Backend-only Auth configuration. Never expose these values to a frontend.
SUPABASE_URL=https://YOUR_AUTH_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_AUTH_ANON_OR_PUBLISHABLE_KEY
AUTH_PROVIDER_TIMEOUT_MS=15000
# Distinct backend-only secrets, each at least 32 UTF-8 bytes. Coordinate rollout with callers.
USER_GATEWAY_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES
USER_DOCTOR_INTERNAL_API_TOKEN=REPLACE_WITH_ANOTHER_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES
USER_APPOINTMENT_INTERNAL_API_TOKEN=REPLACE_WITH_ANOTHER_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES
USER_RECORD_INTERNAL_API_TOKEN=REPLACE_WITH_ANOTHER_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES
DOCTOR_SERVICE_URL=http://localhost:3002
APPOINTMENT_SERVICE_URL=http://localhost:3003
LOG_LEVEL=info
