NOTIFICATION_SERVICE_PORT=3005
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_NOTIFICATION_DB_HOST:5432/postgres
DATABASE_SSL=true
# Supabase pooler may require false unless its CA certificate is installed locally.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
APPOINTMENT_SERVICE_URL=http://localhost:3003
APPOINTMENT_NOTIFICATION_INTERNAL_API_TOKEN=replace-with-distinct-32-byte-secret
NOTIFICATION_INTERNAL_API_TOKEN=replace-with-distinct-32-byte-secret
LOG_LEVEL=info
