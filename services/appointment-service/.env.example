# Copy to services/appointment-service/.env for direct host development.
# Docker Compose reads the root .env and supplies private service DNS URLs instead.
# Replace all REPLACE_* values; never commit populated .env files.
NODE_ENV=development
APPOINTMENT_SERVICE_PORT=3003

# Appointment Service's own database. Do not share this URL with another service.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_URL_ENCODED_PASSWORD@db.REPLACE_WITH_APPOINTMENT_DB_PROJECT.supabase.co:5432/postgres
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

DOCTOR_SERVICE_URL=http://localhost:3002
USER_SERVICE_URL=http://localhost:3001
MEDICAL_RECORD_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005

# Generate each credential as 32 random bytes (64 hex characters), for example:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Copy each value unchanged to its named counterpart; generate a distinct value
# for every credential name. Never use the placeholder text as a real secret.
# Appointment -> User; same value as User Service's USER_APPOINTMENT_INTERNAL_API_TOKEN.
USER_APPOINTMENT_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_APPOINTMENT_TO_USER_TOKEN
# User -> Appointment patient-scope; same value as User Service's APPOINTMENT_USER_INTERNAL_API_TOKEN.
APPOINTMENT_USER_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_USER_TO_APPOINTMENT_TOKEN
# Doctor/Appointment/Record shared contract; same value as Doctor and Medical Record examples.
DOCTOR_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_DOCTOR_INTERNAL_TOKEN
# Medical Record -> Appointment; same value as Medical Record's APPOINTMENT_RECORD_INTERNAL_API_TOKEN.
APPOINTMENT_RECORD_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_APPOINTMENT_RECORD_TOKEN
# Notification -> Appointment; same value as Notification's APPOINTMENT_NOTIFICATION_INTERNAL_API_TOKEN.
APPOINTMENT_NOTIFICATION_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_APPOINTMENT_NOTIFICATION_TOKEN
# Appointment -> Notification (also used by Record); same value as Record/Notification examples.
NOTIFICATION_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_NOTIFICATION_INTERNAL_TOKEN

# Outbox polling interval; increase only with awareness of delivery latency.
APPOINTMENT_OUTBOX_POLL_MS=5000
LOG_LEVEL=info
