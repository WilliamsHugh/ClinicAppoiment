APPOINTMENT_SERVICE_PORT=3003
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_APPOINTMENT_DB_HOST:5432/postgres
DATABASE_SSL=true
# Supabase pooler may require false unless its CA certificate is installed locally.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DOCTOR_SERVICE_URL=http://localhost:3002
USER_SERVICE_URL=http://localhost:3001
# Match User Service's USER_APPOINTMENT_INTERNAL_API_TOKEN; backend-only, distinct 32+ byte secret.
USER_APPOINTMENT_INTERNAL_API_TOKEN=replace-with-distinct-32-byte-secret
# User Service -> Appointment patient-scope lookup; never reuse the Record callback token.
APPOINTMENT_USER_INTERNAL_API_TOKEN=replace-with-another-distinct-32-byte-secret
NOTIFICATION_SERVICE_URL=http://localhost:3005
MEDICAL_RECORD_SERVICE_URL=http://localhost:3004
# Set the same random 32+ byte value as Doctor Service's private .env file.
DOCTOR_INTERNAL_API_TOKEN=replace-with-at-least-32-byte-secret
# Share only with Medical Record Service for lookup and completion callbacks.
APPOINTMENT_RECORD_INTERNAL_API_TOKEN=replace-with-distinct-32-byte-secret
# Share only with Notification Service for reminder context reads.
APPOINTMENT_NOTIFICATION_INTERNAL_API_TOKEN=replace-with-distinct-32-byte-secret
# Share only with Notification Service for event ingestion.
NOTIFICATION_INTERNAL_API_TOKEN=replace-with-distinct-32-byte-secret
APPOINTMENT_OUTBOX_POLL_MS=5000
LOG_LEVEL=info
