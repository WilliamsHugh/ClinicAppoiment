# Health&Human local Compose configuration template.
# Copy this file to the repository root as .env, then replace every REPLACE_* value.
# Never commit .env or paste populated credentials into issues, chat, logs, or screenshots.
# Compose intentionally fails closed until all required URLs and credentials are configured.
# Deployment order:
# 1. Provision five independent PostgreSQL databases/projects and one User Auth project.
# 2. Set each database URL, verify its TLS settings, and generate the internal tokens below.
# 3. Apply each service's documented migrations to that service's database only.
# 4. Validate and start from the repository root:
#    docker compose --env-file .env -f infrastructure/compose/docker-compose.yml config --quiet
#    docker compose --env-file .env -f infrastructure/compose/docker-compose.yml up --build
# For direct host development, copy the corresponding service example to that service's
# ignored .env file and keep its URLs pointed at localhost. Do not combine DB URLs.

NODE_ENV=development
AUTH_DEV_MODE=false

# Supabase Auth is used only by User Service. Use the publishable/anon key, never
# the service_role/secret key. This project is for Auth; USER_DATABASE_URL below
# remains User Service's separately-owned application database.
SUPABASE_URL=https://REPLACE_WITH_USER_AUTH_PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_USER_AUTH_PUBLISHABLE_OR_ANON_KEY
AUTH_PROVIDER_TIMEOUT_MS=15000

# Public local ports and frontend-to-Gateway URLs. Android emulator reaches the
# host through 10.0.2.2; a physical phone needs the host LAN address instead.
GATEWAY_PORT=8080
CLINIC_MANAGEMENT_WEB_PORT=5174
CLINIC_MANAGEMENT_WEB_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5174
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
PATIENT_APP_API_BASE_URL=http://10.0.2.2:8080
# Optional Flutter tooling overrides. Use a device ID reported by `flutter devices`.
# FLUTTER_DEVICE_ID=emulator-5554
# JAVA_HOME=/absolute/path/to/jdk-17

# Gateway limits and upstream timeouts.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_TIMEOUT_MS=3000
HEALTH_CHECK_TIMEOUT_MS=1500
PROXY_TIMEOUT_MS=20000

# Used when running services directly on the host. Compose replaces service URLs
# with private Docker DNS names. Frontends must use only the Gateway URL above.
USER_SERVICE_URL=http://localhost:3001
DOCTOR_SERVICE_URL=http://localhost:3002
APPOINTMENT_SERVICE_URL=http://localhost:3003
MEDICAL_RECORD_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005

# Host ports are for the optional local debug Compose override only. The default
# Compose file does not publish business-service ports.
USER_SERVICE_PORT=3001
DOCTOR_SERVICE_PORT=3002
APPOINTMENT_SERVICE_PORT=3003
MEDICAL_RECORD_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005

# Each service must use its OWN PostgreSQL database/project. Do not copy one
# connection URL to multiple variables. Use the matching Supabase project's
# Connect dialog and URL-encode special characters in the password.
# Prefer the provider's TLS-enabled connection string / pooler as appropriate.
USER_DATABASE_URL=postgresql://postgres:REPLACE_WITH_URL_ENCODED_PASSWORD@db.REPLACE_WITH_USER_DB_PROJECT.supabase.co:5432/postgres
DOCTOR_DATABASE_URL=postgresql://postgres:REPLACE_WITH_URL_ENCODED_PASSWORD@db.REPLACE_WITH_DOCTOR_DB_PROJECT.supabase.co:5432/postgres
APPOINTMENT_DATABASE_URL=postgresql://postgres:REPLACE_WITH_URL_ENCODED_PASSWORD@db.REPLACE_WITH_APPOINTMENT_DB_PROJECT.supabase.co:5432/postgres
MEDICAL_RECORD_DATABASE_URL=postgresql://postgres:REPLACE_WITH_URL_ENCODED_PASSWORD@db.REPLACE_WITH_RECORD_DB_PROJECT.supabase.co:5432/postgres
NOTIFICATION_DATABASE_URL=postgresql://postgres:REPLACE_WITH_URL_ENCODED_PASSWORD@db.REPLACE_WITH_NOTIFICATION_DB_PROJECT.supabase.co:5432/postgres

# TLS is enabled and certificate verification is enabled by default for all five
# databases. Keep REJECT_UNAUTHORIZED=true. If a provider's pooler fails TLS,
# install/configure its CA certificate; do not disable verification in production.
# Download the Supabase root CA certificate once from Dashboard -> Database Settings
# -> SSL Configuration and save it as .local-certs/supabase-ca.crt. All five service
# databases use this shared CA file; keep TLS verification enabled. Compose mounts the
# same file read-only into each service at /run/certs/database-ca.crt.
# .local-certs is excluded from Git and Docker build context; never commit the CA file.
# For host-run services, each service .env points DATABASE_SSL_CA_PATH to the same
# repository file using a path relative to that service workspace. The file must be PEM.
USER_DATABASE_SSL=true
USER_DATABASE_SSL_REJECT_UNAUTHORIZED=true
DOCTOR_DATABASE_SSL=true
DOCTOR_DATABASE_SSL_REJECT_UNAUTHORIZED=true
APPOINTMENT_DATABASE_SSL=true
APPOINTMENT_DATABASE_SSL_REJECT_UNAUTHORIZED=true
MEDICAL_RECORD_DATABASE_SSL=true
MEDICAL_RECORD_DATABASE_SSL_REJECT_UNAUTHORIZED=true
NOTIFICATION_DATABASE_SSL=true
NOTIFICATION_DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Internal credentials: generate a different random 32-byte value for EACH
# credential name, for example:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Copy the generated value unchanged to every service listed for that credential.
# Never use the literal REPLACE_* examples as credentials. Keep all values backend-only.
#
# Credential placement (caller -> provider):
# USER_GATEWAY_INTERNAL_API_TOKEN: Gateway + User Service
# USER_DOCTOR_INTERNAL_API_TOKEN: User + Doctor Service
# USER_APPOINTMENT_INTERNAL_API_TOKEN: User + Appointment Service
# USER_RECORD_INTERNAL_API_TOKEN: User + Medical Record Service
# DOCTOR_USER_INTERNAL_API_TOKEN: User + Doctor Service
# APPOINTMENT_USER_INTERNAL_API_TOKEN: User + Appointment Service
# DOCTOR_INTERNAL_API_TOKEN: Doctor + Appointment + Medical Record Services
# APPOINTMENT_RECORD_INTERNAL_API_TOKEN: Appointment + Medical Record Services
# APPOINTMENT_NOTIFICATION_INTERNAL_API_TOKEN: Appointment + Notification Services
# NOTIFICATION_INTERNAL_API_TOKEN: Appointment + Medical Record + Notification Services
USER_GATEWAY_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_GATEWAY_TO_USER_TOKEN
USER_DOCTOR_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_DOCTOR_TO_USER_TOKEN
USER_APPOINTMENT_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_APPOINTMENT_TO_USER_TOKEN
USER_RECORD_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_RECORD_TO_USER_TOKEN
DOCTOR_USER_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_USER_TO_DOCTOR_TOKEN
APPOINTMENT_USER_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_USER_TO_APPOINTMENT_TOKEN
DOCTOR_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_DOCTOR_INTERNAL_TOKEN
APPOINTMENT_RECORD_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_APPOINTMENT_RECORD_TOKEN
APPOINTMENT_NOTIFICATION_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_APPOINTMENT_NOTIFICATION_TOKEN
NOTIFICATION_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_NOTIFICATION_INTERNAL_TOKEN

# Optional worker/logging settings.
APPOINTMENT_OUTBOX_POLL_MS=5000
LOG_LEVEL=info
