# Copy to services/doctor-service/.env for direct host development.
# Docker Compose reads the root .env and supplies private service DNS URLs instead.
# Replace all REPLACE_* values; never commit populated .env files.
DOCTOR_SERVICE_PORT=3002

# Doctor Service's own database. Do not share this URL with another service.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_URL_ENCODED_PASSWORD@db.REPLACE_WITH_DOCTOR_DB_PROJECT.supabase.co:5432/postgres
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Shared CA file from this workspace directory; Compose mounts it at /run/certs/database-ca.crt.
DATABASE_SSL_CA_PATH=../../.local-certs/supabase-ca.crt

USER_SERVICE_URL=http://localhost:3001
APPOINTMENT_SERVICE_URL=http://localhost:3003

# Generate each credential as 32 random bytes (64 hex characters), for example:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# A credential must exactly match the same variable in its counterpart service,
# but must be different from every other credential. Never paste real values here.
# Doctor -> User eligibility; same value as User Service's USER_DOCTOR_INTERNAL_API_TOKEN.
USER_DOCTOR_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_DOCTOR_TO_USER_TOKEN
# User -> Doctor by-user lookup; same value as User Service's DOCTOR_USER_INTERNAL_API_TOKEN.
DOCTOR_USER_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_USER_TO_DOCTOR_TOKEN
# Doctor <-> Appointment plus Medical Record -> Doctor routes; same value is configured
# as DOCTOR_INTERNAL_API_TOKEN in Appointment and Medical Record Service examples.
DOCTOR_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_DOCTOR_INTERNAL_TOKEN

LOG_LEVEL=info
