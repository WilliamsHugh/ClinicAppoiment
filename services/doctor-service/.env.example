DOCTOR_SERVICE_PORT=3002
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_DOCTOR_DB_HOST:5432/postgres
DATABASE_SSL=true
# Supabase pooler may require false unless its CA certificate is installed locally.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
USER_SERVICE_URL=http://localhost:3001
# Match User Service's USER_DOCTOR_INTERNAL_API_TOKEN; backend-only, distinct 32+ byte secret.
USER_DOCTOR_INTERNAL_API_TOKEN=replace-with-distinct-32-byte-secret
# User Service -> Doctor by-user lookup; distinct from the other by-user callers' token.
DOCTOR_USER_INTERNAL_API_TOKEN=replace-with-another-distinct-32-byte-secret
APPOINTMENT_SERVICE_URL=http://localhost:3003
# Set the same random 32+ byte value in Appointment Service's private .env file.
# DOCTOR_INTERNAL_API_TOKEN=
LOG_LEVEL=info
