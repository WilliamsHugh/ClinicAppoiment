# Copy to a local ignored file named .env.m2-e2e. Never commit populated values.
# All PostgreSQL URLs must point to the five disposable databases on loopback.
M2_E2E_DATABASE_URL_USER=postgresql://postgres:REPLACE_ME@127.0.0.1:5433/user_service_test
M2_E2E_DATABASE_URL_DOCTOR=postgresql://postgres:REPLACE_ME@127.0.0.1:5433/doctor_service_test
M2_E2E_DATABASE_URL_APPOINTMENT=postgresql://postgres:REPLACE_ME@127.0.0.1:5433/appointment_service_test
M2_E2E_DATABASE_URL_RECORD=postgresql://postgres:REPLACE_ME@127.0.0.1:5433/medical_record_service_test
M2_E2E_DATABASE_URL_NOTIFICATION=postgresql://postgres:REPLACE_ME@127.0.0.1:5433/notification_service_test

# Destructive seed and live write switches. Enable only for confirmed disposable DBs.
M2_E2E_ALLOW_DATABASE_RESET=0
M2_E2E_ALLOW_DATABASE_WRITES=0
M2_E2E_RUN_LIVE=0
M2_E2E_SEED_MANIFEST=/absolute/path/to/backend-openapi/.m2-e2e-seed-manifest.json

# Dedicated isolated Supabase Auth test project; never point these to production.
M2_E2E_SUPABASE_URL=https://REPLACE_WITH_DEDICATED_TEST_PROJECT.supabase.co
M2_E2E_SUPABASE_ANON_KEY=REPLACE_WITH_TEST_PROJECT_PUBLISHABLE_KEY
M2_E2E_SUPABASE_PROJECT_REF=REPLACE_WITH_TEST_PROJECT_REF
M2_E2E_AUTH_PROJECT_ISOLATED=0

# Pre-provision these four test users in the isolated Auth project. Do not print them.
M2_E2E_PATIENT_EMAIL=patient.e2e@example.test
M2_E2E_STAFF_EMAIL=staff.e2e@example.test
M2_E2E_DOCTOR_EMAIL=doctor.e2e@example.test
M2_E2E_ADMIN_EMAIL=admin.e2e@example.test
M2_E2E_TEST_PASSWORD=REPLACE_WITH_TEST_ONLY_PASSWORD
M2_E2E_TEST_TOTP_SECRET=REPLACE_WITH_TEST_ONLY_TOTP_SECRET

# Generate distinct random internal credentials for this local test run.
USER_GATEWAY_INTERNAL_API_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_TOKEN
USER_DOCTOR_INTERNAL_API_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_TOKEN
USER_APPOINTMENT_INTERNAL_API_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_TOKEN
USER_RECORD_INTERNAL_API_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_TOKEN
DOCTOR_USER_INTERNAL_API_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_TOKEN
DOCTOR_INTERNAL_API_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_TOKEN
APPOINTMENT_USER_INTERNAL_API_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_TOKEN
RECORD_APPOINTMENT_INTERNAL_API_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_TOKEN
APPOINTMENT_RECORD_INTERNAL_API_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_TOKEN
APPOINTMENT_NOTIFICATION_INTERNAL_API_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_TOKEN
NOTIFICATION_INTERNAL_API_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_TOKEN
