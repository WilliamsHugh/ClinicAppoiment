# Copy to services/notification-service/.env for direct host development.
# Docker Compose reads the root .env and supplies private service DNS URLs instead.
# Replace all REPLACE_* values; never commit populated .env files.
NOTIFICATION_SERVICE_PORT=3005

# Notification Service's own database. Do not share this URL with another service.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_URL_ENCODED_PASSWORD@db.REPLACE_WITH_NOTIFICATION_DB_PROJECT.supabase.co:5432/postgres
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

APPOINTMENT_SERVICE_URL=http://localhost:3003

# Generate two DIFFERENT 32-byte random credentials (64 hex characters), e.g.:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Copy each generated value unchanged to its counterpart. These credentials are
# for opposite directions and must not be equal or reused elsewhere.
# Notification -> Appointment reminder-context; same value as Appointment's APPOINTMENT_NOTIFICATION_INTERNAL_API_TOKEN.
APPOINTMENT_NOTIFICATION_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_APPOINTMENT_NOTIFICATION_TOKEN
# Appointment/Medical Record -> Notification event intake; same value as those callers' NOTIFICATION_INTERNAL_API_TOKEN.
NOTIFICATION_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_NOTIFICATION_INTERNAL_TOKEN

LOG_LEVEL=info
