# Copy to services/user-service/.env for direct host development.
# For Docker Compose, configure the matching variables in the root .env instead.
# Replace all REPLACE_* values. Never commit populated .env files.
USER_SERVICE_PORT=3001

# This database belongs only to User Service; do not reuse another service's DB URL.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_URL_ENCODED_PASSWORD@db.REPLACE_WITH_USER_DB_PROJECT.supabase.co:5432/postgres
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Supabase Auth credentials are backend-only and used only by User Service.
# Use the publishable/anon key, never the service_role/secret key.
SUPABASE_URL=https://REPLACE_WITH_USER_AUTH_PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_USER_AUTH_PUBLISHABLE_OR_ANON_KEY
AUTH_PROVIDER_TIMEOUT_MS=15000

# Create each credential once with 32 random bytes, e.g.:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Copy the exact same generated value to the named caller/provider counterpart.
# Generate a different value for every credential name; do not reuse credentials.
USER_GATEWAY_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_GATEWAY_TO_USER_TOKEN
USER_DOCTOR_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_DOCTOR_TO_USER_TOKEN
USER_APPOINTMENT_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_APPOINTMENT_TO_USER_TOKEN
USER_RECORD_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_RECORD_TO_USER_TOKEN
DOCTOR_USER_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_USER_TO_DOCTOR_TOKEN
APPOINTMENT_USER_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_USER_TO_APPOINTMENT_TOKEN

# These URLs are for direct host development only. Compose injects private service DNS URLs.
DOCTOR_SERVICE_URL=http://localhost:3002
APPOINTMENT_SERVICE_URL=http://localhost:3003
LOG_LEVEL=info
