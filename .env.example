# Local development defaults. Do not commit a populated .env file.
NODE_ENV=development

# Gateway authentication policy. Keep AUTH_DEV_MODE=false outside local fixture testing.
AUTH_DEV_MODE=true
# Backend-only Supabase Auth configuration used only by User Service.
# These values must never be passed to either frontend.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# Public host ports and browser-facing URLs.
GATEWAY_PORT=8080
CLINIC_MANAGEMENT_WEB_PORT=5174
CLINIC_MANAGEMENT_WEB_URL=http://localhost:5174
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
PATIENT_APP_API_BASE_URL=http://10.0.2.2:8080
# Optional local toolchain overrides. Device IDs are listed by `flutter devices`.
# FLUTTER_DEVICE_ID=emulator-5554
# JAVA_HOME=/absolute/path/to/jdk-17

# Gateway limits and timeouts.
CORS_ORIGINS=http://localhost:5174
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_TIMEOUT_MS=3000
HEALTH_CHECK_TIMEOUT_MS=1500
PROXY_TIMEOUT_MS=10000

# Used when services run directly on the host. Compose overrides these with
# service DNS names and keeps the service ports private by default.
USER_SERVICE_URL=http://localhost:3001
DOCTOR_SERVICE_URL=http://localhost:3002
APPOINTMENT_SERVICE_URL=http://localhost:3003
MEDICAL_RECORD_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005

# Host ports used only by infrastructure/compose/docker-compose.debug.yml.
USER_SERVICE_PORT=3001
DOCTOR_SERVICE_PORT=3002
APPOINTMENT_SERVICE_PORT=3003
MEDICAL_RECORD_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005

# Each service owns an independent PostgreSQL database. For Supabase, provision
# one project/database per service and never expose these URLs to a frontend.
# USER_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@USER_HOST:5432/postgres
# DOCTOR_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@DOCTOR_HOST:5432/postgres
# APPOINTMENT_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@APPOINTMENT_HOST:5432/postgres
# MEDICAL_RECORD_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@RECORD_HOST:5432/postgres
# NOTIFICATION_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@NOTIFICATION_HOST:5432/postgres
# USER_DATABASE_SSL=true
# USER_DATABASE_SSL_REJECT_UNAUTHORIZED=false
# DOCTOR_DATABASE_SSL=true
# APPOINTMENT_DATABASE_SSL=true
# MEDICAL_RECORD_DATABASE_SSL=true
# NOTIFICATION_DATABASE_SSL=true
# NOTIFICATION_DATABASE_SSL_REJECT_UNAUTHORIZED=false
LOG_LEVEL=info
