# Copy to services/medical-record-service/.env for direct host development.
# Docker Compose reads the root .env and supplies private service DNS URLs instead.
# Replace all REPLACE_* values; never commit populated .env files.
MEDICAL_RECORD_SERVICE_PORT=3004

# Medical Record Service's own database. Do not share this URL with another service.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_URL_ENCODED_PASSWORD@db.REPLACE_WITH_RECORD_DB_PROJECT.supabase.co:5432/postgres
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Shared CA file from this workspace directory; Compose mounts it at /run/certs/database-ca.crt.
DATABASE_SSL_CA_PATH=../../.local-certs/supabase-ca.crt

APPOINTMENT_SERVICE_URL=http://localhost:3003
USER_SERVICE_URL=http://localhost:3001
DOCTOR_SERVICE_URL=http://localhost:3002
NOTIFICATION_SERVICE_URL=http://localhost:3005

# Generate a different 32-byte random value for each credential name, for example:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Copy the generated value unchanged to its named caller/provider counterpart.
# Do not reuse one credential for multiple routes or services.
# Medical Record -> Appointment completion/verification; same value as Appointment's APPOINTMENT_RECORD_INTERNAL_API_TOKEN.
APPOINTMENT_RECORD_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_APPOINTMENT_RECORD_TOKEN
# Medical Record -> Notification; same value as Appointment/Notification's NOTIFICATION_INTERNAL_API_TOKEN.
NOTIFICATION_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_NOTIFICATION_INTERNAL_TOKEN
# Medical Record -> User patient lookups; same value as User's USER_RECORD_INTERNAL_API_TOKEN.
USER_RECORD_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_RECORD_TO_USER_TOKEN
# Medical Record -> Doctor lookup; same shared value as Doctor/Appointment's DOCTOR_INTERNAL_API_TOKEN.
DOCTOR_INTERNAL_API_TOKEN=REPLACE_WITH_UNIQUE_DOCTOR_INTERNAL_TOKEN

LOG_LEVEL=info
